<?xml version="1.0"?>
<sdf version="1.8">
  <world name="dqn">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- PRIMA STANZA -->

    <!-- Parete Nord Stanza 1 -->
    <model name="wall_north1">
      <static>true</static>
      <pose>0 2.05 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parete Sud Stanza 1 -->
    <model name="wall_south1">
      <static>true</static>
      <pose>0 -2.05 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

        <!-- Parete Est Stanza 1 (solo parte superiore) -->
    <model name="wall_east1_top">
      <static>true</static>
      <pose>2.05 1.25 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 1.5 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 1.5 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parete Est Stanza 1 (solo parte inferiore) -->
    <model name="wall_east1_bottom">
      <static>true</static>
      <pose>2.05 -1.25 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 1.5 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 1.5 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parete Ovest Stanza 1 -->
    <model name="wall_west1">
      <static>true</static>
      <pose>-2.05 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 4.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 4.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SECONDA STANZA -->

    <!-- Parete Nord Stanza 2 -->
    <model name="wall_north2">
      <static>true</static>
      <pose>4.2 2.05 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parete Sud Stanza 2 -->
    <model name="wall_south2">
      <static>true</static>
      <pose>4.2 -2.05 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>4.2 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parete Est Stanza 2 -->
    <model name="wall_east2">
      <static>true</static>
      <pose>6.25 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 4.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 4.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dynamic Actor -->
    <actor name="pedestrian">
      <pose>0 0.25 0 0 0 0</pose>
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorPhone/tip/files/meshes/MaleVisitorPhoneIdle.dae</filename>
        <scale>0.25</scale>
      </skin>
      <!-- walking animation -->
      <animation name="stand">
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorPhone/tip/files/meshes/MaleVisitorPhoneIdle.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        
        <!-- Segmento 1: Movimento verso sinistra (faccia a sinistra) -->
        <trajectory id="0" type="standing">
          <waypoint>
            <time>0.0</time>
            <pose>0 0.25 0 0 0 3.14159</pose> <!-- Yaw=180° (faccia a sinistra) -->
          </waypoint>
          <waypoint>
            <time>15.0</time>
            <pose>-1.8 0.25 0 0 0 3.14159</pose> <!-- Rimane entro i limiti -->
          </waypoint>
        </trajectory>
        
        <!-- Segmento 2: Movimento verso destra (ruota e affronta destra) -->
        <trajectory id="1" type="standing">
          <waypoint>
            <time>15.0</time>
            <pose>-1.8 0.25 0 0 0 0</pose> <!-- Yaw=0° (faccia a destra) -->
          </waypoint>
          <waypoint>
            <time>45.0</time>
            <pose>1.8 0.25 0 0 0 0</pose> <!-- Rimane entro i limiti -->
          </waypoint>
        </trajectory>
        
        <!-- Segmento 3: Ritorno a sinistra (ruota e affronta sinistra) -->
        <trajectory id="2" type="standing">
          <waypoint>
            <time>45.0</time>
            <pose>1.8 0.25 0 0 0 3.14159</pose> <!-- Yaw=180° (faccia a sinistra) -->
          </waypoint>
          <waypoint>
            <time>60.0</time>
            <pose>0 0.25 0 0 0 3.14159</pose> <!-- Torna al centro -->
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Secondo Dynamic Actor nella seconda stanza con movimento ruotato di 90° -->
    <actor name="pedestrian2">
      <pose>2.0 0 0 0 0 0</pose>
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorPhone/tip/files/meshes/MaleVisitorPhoneIdle.dae</filename>
        <scale>0.25</scale>
      </skin>
      <!-- walking animation -->
      <animation name="stand">
        <filename>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorPhone/tip/files/meshes/MaleVisitorPhoneIdle.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        
        <!-- Segmento 1: Movimento verso nord (faccia a nord) -->
        <trajectory id="0" type="standing">
          <waypoint>
            <time>0.0</time>
            <pose>2.0 0 0 0 0 1.5708</pose> <!-- Yaw=90° (faccia a nord) -->
          </waypoint>
          <waypoint>
            <time>8.0</time>
            <pose>2.0 1.8 0 0 0 1.5708</pose> <!-- Movimento verso nord -->
          </waypoint>
        </trajectory>
        
        <!-- Segmento 2: Movimento verso sud (ruota e affronta sud) -->
        <trajectory id="1" type="standing">
          <waypoint>
            <time>8.0</time>
            <pose>2.0 1.8 0 0 0 -1.5708</pose> <!-- Yaw=-90° (faccia a sud) -->
          </waypoint>
          <waypoint>
            <time>24.0</time>
            <pose>2.0 -1.8 0 0 0 -1.5708</pose> <!-- Movimento verso sud -->
          </waypoint>
        </trajectory>
        
        <!-- Segmento 3: Ritorno a nord (ruota e affronta nord) -->
        <trajectory id="2" type="standing">
          <waypoint>
            <time>24.0</time>
            <pose>2.0 -1.8 0 0 0 1.5708</pose> <!-- Yaw=90° (faccia a nord) -->
          </waypoint>
          <waypoint>
            <time>32.0</time>
            <pose>2.0 0 0 0 0 1.5708</pose> <!-- Torna al centro -->
          </waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>